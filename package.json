{
  "name": "dsh-xray",
  "version": "0.5.0",
  "description": "X-ray for your DeepSeek Harness — see what's actually loaded, why, and what it costs you.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alloevil/dsh-xray.git"
  },
  "homepage": "https://github.com/alloevil/dsh-xray#readme",
  "bugs": "https://github.com/alloevil/dsh-xray/issues",
  "license": "MIT",
  "main": "lib/index.js",
  "bin": {
    "dsh-xray": "bin/xray.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs",
    "assets"
  ],
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "scripts": {
    "test": "node --test tests/*.spec.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && node --test tests/*.spec.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 tests/*.spec.js"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "diagnostics",
    "introspection",
    "plugin-tree",
    "dependency-graph",
    "observability",
    "audit",
    "security-scan",
    "token-cost",
    "lockfile",
    "troubleshooting"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9"
  }
}
